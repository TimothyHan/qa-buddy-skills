#!/bin/bash
# QABuddy — GitHub Copilot Setup
# Copies skills into .github/skills/ in the current repo so Copilot can discover them.
# Copilot reads skills from the repo (not a global directory).

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SDT_SKILLS="$SCRIPT_DIR/skills"
SDT_REFS="$SCRIPT_DIR/references"

# Copilot reads from .github/skills/ in the repo
SKILLS_DIR=".github/skills"

SKILLS=()
for _skill_dir in "$SDT_SKILLS"/*/; do
  [ -d "$_skill_dir" ] && SKILLS+=("$(basename "$_skill_dir")")
done

# --adopt: stamp ownership markers onto pre-v0.2.3 QABuddy copies so the
# normal flow can manage them. Evidence required: qa- prefixed real directory,
# no marker, SKILL.md mentioning QABuddy (references: playbook/ present).
adopt_legacy() {
  local dir="$1"
  local adopted=0
  for skill in "${SKILLS[@]}"; do
    d="$dir/qa-$skill"
    if [ -d "$d" ] && [ ! -L "$d" ] && [ ! -f "$d/.qabuddy-owned" ] && grep -q "QABuddy" "$d/SKILL.md" 2>/dev/null; then
      echo "adopted pre-v0.2.3 copy" > "$d/.qabuddy-owned"
      echo "  ADOPTED  qa-$skill (legacy copy — marker stamped)"
      adopted=$((adopted + 1))
    fi
  done
  rd="$dir/qa-references"
  if [ -d "$rd" ] && [ ! -L "$rd" ] && [ ! -f "$rd/.qabuddy-owned" ] && [ -d "$rd/playbook" ]; then
    echo "adopted pre-v0.2.3 copy" > "$rd/.qabuddy-owned"
    echo "  ADOPTED  qa-references (legacy copy — marker stamped)"
    adopted=$((adopted + 1))
  fi
  if [ $adopted -eq 0 ]; then
    echo "  (no legacy copies found in $dir)"
  fi
  return 0
}

usage() {
  echo "QABuddy — GitHub Copilot Setup"
  echo ""
  echo "Usage: $0 [OPTIONS]"
  echo ""
  echo "Copies QABuddy skills into .github/skills/ in the current repo."
  echo "Must be run from within a git repository."
  echo ""
  echo "Options:"
  echo "  --no-prefix    Install without 'qa-' prefix"
  echo "  --uninstall    Remove all QABuddy skills from .github/skills/"
  echo "  --status       Show current installation status"
  echo "  --adopt        Stamp ownership markers onto pre-v0.2.3 QABuddy copies, then install"
  echo "  --help         Show this help"
}

# Parse args
PREFIX="qa-"
ACTION="install"

ADOPT=0
case "${1:-}" in
  --no-prefix)  PREFIX="" ;;
  --uninstall)  ACTION="uninstall" ;;
  --status)     ACTION="status" ;;
  --adopt)      ADOPT=1 ;;
  --help|-h)    usage; exit 0 ;;
  "")           ;; # default: install with prefix
  *)            echo "Unknown option: $1"; usage; exit 1 ;;
esac

# Verify we're in a git repo
if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
  echo "ERROR: Not in a git repository."
  echo "Copilot reads skills from .github/skills/ in the repo."
  echo "Run this script from within your project repo."
  exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
SKILLS_DIR="$REPO_ROOT/.github/skills"

# ─── Orphan pruning ──────────────────────────────────────────────────────────
# A skill QABuddy shipped once and no longer ships leaves an owned entry behind.
# `uninstall` and `status` both iterate SKILLS — the skills that exist *now* — so an
# entry for a removed skill is invisible to every code path: nothing reports it, and
# nothing deletes it. For symlink installs it is left dangling at a build path that no
# longer exists, which the assistant still tries to discover. So enumerate the install
# directory instead, and treat an owned entry we no longer ship as an orphan.
# Ownership uses exactly the checks install/uninstall already use — never touch a link
# or directory that isn't ours.
qabuddy_orphans() {
  [ -d "$SKILLS_DIR" ] || return 0
  local entry name base shipped link_target s
  for entry in "$SKILLS_DIR"/*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    name=$(basename "$entry")
    case "$name" in
      qa-references|slowhama-references|slowhama-qa-references) continue ;;
    esac
    if [ -L "$entry" ]; then
      link_target=$(readlink "$entry" 2>/dev/null || true)
      case "$link_target" in
        *"$SDT_SKILLS"*|*qa-skills*) ;;
        *) continue ;;
      esac
    elif [ -d "$entry" ]; then
      [ -f "$entry/.qabuddy-owned" ] || continue
    else
      continue
    fi
    base=${name#qa-}
    shipped=""
    for s in "${SKILLS[@]}"; do
      if [ "$s" = "$base" ] || [ "$s" = "$name" ]; then shipped="yes"; break; fi
    done
    [ -n "$shipped" ] || printf '%s\n' "$entry"
  done
}

# $1 = remove | report. Sets ORPHANS to the count handled.
qabuddy_prune_orphans() {
  ORPHANS=0
  local o
  while IFS= read -r o; do
    [ -n "$o" ] || continue
    ORPHANS=$((ORPHANS + 1))
    if [ "$1" = "remove" ]; then
      if [ -L "$o" ]; then rm "$o"; else rm -rf "$o"; fi
      echo "  PRUNED   $(basename "$o") (no longer shipped by QABuddy)"
    else
      echo "  ORPHAN   $(basename "$o") (no longer shipped — re-run setup to prune)"
    fi
  done <<ORPHAN_EOF
$(qabuddy_orphans)
ORPHAN_EOF
  return 0
}

# ─── Uninstall ───────────────────────────────────────────────────────────────

if [ "$ACTION" = "uninstall" ]; then
  echo "QABuddy — Uninstall (Copilot)"
  echo "================================="
  echo ""
  removed=0
  for skill in "${SKILLS[@]}"; do
    for target in "$SKILLS_DIR/qa-$skill" "$SKILLS_DIR/$skill"; do
      if [ -d "$target" ]; then
        if [ -f "$target/.qabuddy-owned" ]; then
          rm -rf "$target"
          echo "  REMOVED  $(basename "$target")"
          removed=$((removed + 1))
        else
          echo "  SKIP     $(basename "$target") (no ownership marker — left untouched)"
        fi
      fi
    done
  done
  if [ -d "$SKILLS_DIR/qa-references" ]; then
    if [ -f "$SKILLS_DIR/qa-references/.qabuddy-owned" ]; then
      rm -rf "$SKILLS_DIR/qa-references"
      echo "  REMOVED  qa-references"
      removed=$((removed + 1))
    else
      echo "  SKIP     qa-references (no ownership marker — left untouched)"
    fi
  fi
  # Remove copilot instructions if it's ours
  instructions="$REPO_ROOT/.github/copilot-instructions.md"
  if [ -f "$instructions" ] && grep -q "QABuddy" "$instructions" 2>/dev/null; then
    echo ""
    echo "  NOTE    .github/copilot-instructions.md exists and contains QABuddy content."
    echo "          Remove manually if desired: rm $instructions"
  fi
  echo ""
  qabuddy_prune_orphans remove
  removed=$((removed + ORPHANS))
  echo "Removed: $removed items"
  exit 0
fi

# ─── Status ──────────────────────────────────────────────────────────────────

if [ "$ACTION" = "status" ]; then
  echo "QABuddy — Status (Copilot)"
  echo "=============================="
  echo ""
  echo "Skills directory: $SKILLS_DIR"
  echo ""
  for skill in "${SKILLS[@]}"; do
    found=""
    for target in "$SKILLS_DIR/qa-$skill" "$SKILLS_DIR/$skill"; do
      if [ -d "$target" ]; then
        if [ -f "$target/.qabuddy-owned" ]; then
          echo "  OK      $(basename "$target")"
          found="yes"
        else
          echo "  FOREIGN $(basename "$target") (not QABuddy's — ignored)"
        fi
      fi
    done
    [ -z "$found" ] && echo "  MISSING $skill"
  done
  qabuddy_prune_orphans report
  echo ""
  if [ -d "$SKILLS_DIR/qa-references" ]; then
    echo "  OK      qa-references"
  else
    echo "  MISSING qa-references"
  fi
  echo ""
  if [ -f "$REPO_ROOT/.github/copilot-instructions.md" ]; then
    echo "  OK      .github/copilot-instructions.md exists"
  else
    echo "  MISSING .github/copilot-instructions.md"
  fi
  echo ""
  # Check Playwright MCP
  if [ -f ".vscode/mcp.json" ] && grep -q "playwright" ".vscode/mcp.json" 2>/dev/null; then
    echo "  OK      Playwright MCP configured"
  else
    echo "  WARN    Playwright MCP not detected in .vscode/mcp.json"
  fi
  # Check Atlassian MCP
  if [ -f ".vscode/mcp.json" ] && grep -q "atlassian" ".vscode/mcp.json" 2>/dev/null; then
    echo "  OK      Atlassian MCP configured"
  else
    echo "  WARN    Atlassian MCP not detected in .vscode/mcp.json"
  fi
  exit 0
fi

# ─── Install ─────────────────────────────────────────────────────────────────

echo "QABuddy — Setup (Copilot)"
echo "NOTE: Copilot is an UNVERIFIED platform — CI does not execute this installer."
echo "      Officially supported: Claude Code. Issue reports welcome."
echo "============================="
echo ""
if [ "$ADOPT" = "1" ]; then
  echo "Adopting pre-v0.2.3 legacy copies:"
  adopt_legacy "$SKILLS_DIR"
  echo ""
fi

mkdir -p "$SKILLS_DIR"

qabuddy_prune_orphans remove

installed=0
skipped=0

for skill in "${SKILLS[@]}"; do
  target="$SKILLS_DIR/${PREFIX}$skill"
  source="$SDT_SKILLS/$skill"

  if [ ! -d "$source" ]; then
    echo "  SKIP    $skill (source not found)"
    skipped=$((skipped + 1))
    continue
  fi

  if [ -d "$target" ] && [ ! -f "$target/.qabuddy-owned" ]; then
    echo "  FAIL    ${PREFIX}$skill — unowned directory occupies $target. Pre-v0.2.3 QABuddy copy? Re-run with --adopt. Otherwise remove it manually."
    skipped=$((skipped + 1))
    continue
  fi
  rm -rf "$target"
  cp -r "$source" "$target"
  echo "$source" > "$target/.qabuddy-owned"
  echo "  OK      ${PREFIX}$skill"
  installed=$((installed + 1))
done

# Install references
ref_target="$SKILLS_DIR/qa-references"
if [ -d "$SDT_REFS" ]; then
  if [ -d "$ref_target" ] && [ ! -f "$ref_target/.qabuddy-owned" ]; then
    echo "  FAIL    qa-references — another directory occupies $ref_target. Remove it manually."
  else
    rm -rf "$ref_target"
    cp -r "$SDT_REFS" "$ref_target"
    echo "$SDT_REFS" > "$ref_target/.qabuddy-owned"
    echo "  OK      qa-references"
    installed=$((installed + 1))
  fi
fi

echo ""
echo "Installed: $installed items ($((installed - 1)) skills + references)"
[ $skipped -gt 0 ] && echo "Skipped: $skipped skills"

# ─── Project Instructions ───────────────────────────────────────────────────

echo ""
instructions="$REPO_ROOT/.github/copilot-instructions.md"
if [ -f "$instructions" ]; then
  echo "  OK      .github/copilot-instructions.md already exists"
  echo "  INFO    Review and merge QABuddy instructions manually if needed."
  echo "  INFO    Template: $SCRIPT_DIR/.github/copilot-instructions.md"
else
  project_file="$SCRIPT_DIR/.github/copilot-instructions.md"
  if [ -f "$project_file" ]; then
    mkdir -p "$(dirname "$instructions")"
    cp "$project_file" "$instructions"
    echo "  OK      Created .github/copilot-instructions.md"
  fi
fi

# ─── MCP Checks ─────────────────────────────────────────────────────────────

echo ""
echo "Checking MCP servers..."

# Playwright MCP
if [ -f ".vscode/mcp.json" ] && grep -q "playwright" ".vscode/mcp.json" 2>/dev/null; then
  echo "  OK      Playwright MCP configured"
else
  echo "  WARN    Playwright MCP not detected"
  echo ""
  echo "  Browser-testing skills need Playwright MCP."
  echo "  Add to .vscode/mcp.json:"
  echo ""
  echo '  {
    "mcpServers": {
      "playwright": {
        "command": "npx",
        "args": ["@playwright/mcp@latest"]
      }
    }
  }'
fi

# Atlassian MCP
echo ""
if [ -f ".vscode/mcp.json" ] && grep -q "atlassian" ".vscode/mcp.json" 2>/dev/null; then
  echo "  OK      Atlassian MCP configured"
else
  echo "  WARN    Atlassian MCP not detected"
  echo ""
  echo "  Most QABuddy skills need Jira/Confluence access via Atlassian MCP."
  echo "  Add to .vscode/mcp.json:"
  echo ""
  echo '  {
    "mcpServers": {
      "atlassian": {
        "command": "npx",
        "args": ["-y", "@anthropic/mcp-atlassian"],
        "env": {
          "JIRA_URL": "https://your-domain.atlassian.net",
          "JIRA_EMAIL": "your-email@company.com",
          "JIRA_API_TOKEN": "your-api-token"
        }
      }
    }
  }'
fi

# ─── Summary ─────────────────────────────────────────────────────────────────

echo ""
echo "─────────────────────────────────────"
echo "Skills copied to .github/skills/. Copilot will discover them automatically."
echo ""
echo "Remember to commit .github/skills/ to your repo so all team members get them."
echo ""
echo "Check status:  $0 --status"
echo "Uninstall:     $0 --uninstall"
