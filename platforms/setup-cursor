#!/bin/bash
# QABuddy — Cursor Setup
# Symlinks skills into ~/.cursor/skills/ so Cursor can discover them.
# Also checks for Playwright MCP and Atlassian MCP configuration.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$HOME/.cursor/skills"
SDT_SKILLS="$SCRIPT_DIR/skills"
SDT_REFS="$SCRIPT_DIR/references"

SKILLS=()
for _skill_dir in "$SDT_SKILLS"/*/; do
  [ -d "$_skill_dir" ] && SKILLS+=("$(basename "$_skill_dir")")
done

# --adopt: stamp ownership markers onto pre-v0.2.3 QABuddy copies so the
# normal flow can manage them. Evidence required: qa- prefixed real directory,
# no marker, SKILL.md mentioning QABuddy (references: playbook/ present).
adopt_legacy() {
  local dir="$1"
  local adopted=0
  for skill in "${SKILLS[@]}"; do
    d="$dir/qa-$skill"
    if [ -d "$d" ] && [ ! -L "$d" ] && [ ! -f "$d/.qabuddy-owned" ] && grep -q "QABuddy" "$d/SKILL.md" 2>/dev/null; then
      echo "adopted pre-v0.2.3 copy" > "$d/.qabuddy-owned"
      echo "  ADOPTED  qa-$skill (legacy copy — marker stamped)"
      adopted=$((adopted + 1))
    fi
  done
  rd="$dir/qa-references"
  if [ -d "$rd" ] && [ ! -L "$rd" ] && [ ! -f "$rd/.qabuddy-owned" ] && [ -d "$rd/playbook" ]; then
    echo "adopted pre-v0.2.3 copy" > "$rd/.qabuddy-owned"
    echo "  ADOPTED  qa-references (legacy copy — marker stamped)"
    adopted=$((adopted + 1))
  fi
  if [ $adopted -eq 0 ]; then
    echo "  (no legacy copies found in $dir)"
  fi
  return 0
}

usage() {
  echo "QABuddy — Cursor Setup"
  echo ""
  echo "Usage: $0 [OPTIONS]"
  echo ""
  echo "Options:"
  echo "  --no-prefix    Install without 'qa-' prefix"
  echo "  --project      Copy skills into .cursor/skills/ in current project instead of global"
  echo "  --uninstall    Remove all QABuddy skill symlinks"
  echo "  --status       Show current installation status"
  echo "  --adopt        Stamp ownership markers onto pre-v0.2.3 QABuddy copies (global + ./.cursor/skills), then install"
  echo "  --help         Show this help"
}

# Parse args
PREFIX="qa-"
ACTION="install"
MODE="global"
ADOPT=0

# Every flag is parsed, not just the first. `setup --no-prefix --status` used to fall
# through to a plain install with --status silently ignored — a read-only command that
# mutated. Two actions at once is a mistake worth naming, not resolving silently.
set_action() {
  if [ "$ACTION" != "install" ] && [ "$ACTION" != "$1" ]; then
    echo "Conflicting options: --$ACTION and --$1"
    usage
    exit 1
  fi
  ACTION="$1"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --no-prefix)  PREFIX="" ;;
    --project)    MODE="project" ;;
    --uninstall)  set_action uninstall ;;
    --status)     set_action status ;;
    --adopt)      ADOPT=1 ;;
    --help|-h)    usage; exit 0 ;;
    *)            echo "Unknown option: $1"; usage; exit 1 ;;
  esac
  shift
done

if [ "$MODE" = "project" ]; then
  SKILLS_DIR=".cursor/skills"
fi

# ─── Orphan pruning ──────────────────────────────────────────────────────────
# A skill QABuddy shipped once and no longer ships leaves an owned entry behind.
# `uninstall` and `status` both iterate SKILLS — the skills that exist *now* — so an
# entry for a removed skill is invisible to every code path: nothing reports it, and
# nothing deletes it. For symlink installs it is left dangling at a build path that no
# longer exists, which the assistant still tries to discover. So enumerate the install
# directory instead, and treat an owned entry we no longer ship as an orphan.
# Ownership uses exactly the checks install/uninstall already use — never touch a link
# or directory that isn't ours.
qabuddy_orphans() {
  [ -d "$SKILLS_DIR" ] || return 0
  local entry name base shipped link_target s
  for entry in "$SKILLS_DIR"/*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    name=$(basename "$entry")
    case "$name" in
      qa-references|slowhama-references|slowhama-qa-references) continue ;;
    esac
    if [ -L "$entry" ]; then
      link_target=$(readlink "$entry" 2>/dev/null || true)
      case "$link_target" in
        *"$SDT_SKILLS"*|*qa-skills*) ;;
        *) continue ;;
      esac
    elif [ -d "$entry" ]; then
      [ -f "$entry/.qabuddy-owned" ] || continue
    else
      continue
    fi
    base=${name#qa-}
    shipped=""
    for s in "${SKILLS[@]}"; do
      if [ "$s" = "$base" ] || [ "$s" = "$name" ]; then shipped="yes"; break; fi
    done
    [ -n "$shipped" ] || printf '%s\n' "$entry"
  done
}

# $1 = remove | report. Sets ORPHANS to the count handled.
qabuddy_prune_orphans() {
  ORPHANS=0
  local o
  while IFS= read -r o; do
    [ -n "$o" ] || continue
    ORPHANS=$((ORPHANS + 1))
    if [ "$1" = "remove" ]; then
      if [ -L "$o" ]; then rm "$o"; else rm -rf "$o"; fi
      echo "  PRUNED   $(basename "$o") (no longer shipped by QABuddy)"
    else
      echo "  ORPHAN   $(basename "$o") (no longer shipped — re-run setup to prune)"
    fi
  done <<ORPHAN_EOF
$(qabuddy_orphans)
ORPHAN_EOF
  return 0
}

# ─── Uninstall ───────────────────────────────────────────────────────────────

if [ "$ACTION" = "uninstall" ]; then
  echo "QABuddy — Uninstall (Cursor)"
  echo "================================"
  echo ""
  removed=0
  for skill in "${SKILLS[@]}"; do
    for target in "$SKILLS_DIR/qa-$skill" "$SKILLS_DIR/$skill"; do
      if [ -L "$target" ]; then
        link_target=$(readlink "$target" 2>/dev/null || true)
        if [[ "$link_target" == *"$SDT_SKILLS"* ]] || [[ "$link_target" == *"qa-skills"* ]]; then
          rm "$target"
          echo "  REMOVED  $(basename "$target")"
          removed=$((removed + 1))
        else
          echo "  SKIP     $(basename "$target") (not QABuddy's — left untouched)"
        fi
      elif [ -d "$target" ] && [ "$MODE" = "project" ]; then
        if [ -f "$target/.qabuddy-owned" ]; then
          rm -rf "$target"
          echo "  REMOVED  $(basename "$target") (directory)"
          removed=$((removed + 1))
        else
          echo "  SKIP     $(basename "$target") (no ownership marker — left untouched)"
        fi
      fi
    done
  done
  for target in "$SKILLS_DIR/qa-references"; do
    if [ -L "$target" ]; then
      rm "$target"
      echo "  REMOVED  qa-references"
      removed=$((removed + 1))
    elif [ -d "$target" ] && [ -f "$target/.qabuddy-owned" ]; then
      rm -rf "$target"
      echo "  REMOVED  qa-references (directory)"
      removed=$((removed + 1))
    fi
  done
  echo ""
  qabuddy_prune_orphans remove
  removed=$((removed + ORPHANS))
  echo "Removed: $removed items"
  exit 0
fi

# ─── Status ──────────────────────────────────────────────────────────────────

if [ "$ACTION" = "status" ]; then
  echo "QABuddy — Status (Cursor)"
  echo "============================="
  echo ""
  echo "Skills directory: $SKILLS_DIR"
  echo ""
  for skill in "${SKILLS[@]}"; do
    found=""
    for target in "$SKILLS_DIR/qa-$skill" "$SKILLS_DIR/$skill"; do
      if [ -L "$target" ]; then
        link_target=$(readlink "$target" 2>/dev/null || true)
        if [[ "$link_target" == *"$SDT_SKILLS"* ]] || [[ "$link_target" == *"qa-skills"* ]]; then
          echo "  OK      $(basename "$target") -> $link_target"
          found="yes"
        else
          echo "  FOREIGN $(basename "$target") -> $link_target (not QABuddy's — ignored)"
        fi
      elif [ -d "$target" ] && [ -f "$target/.qabuddy-owned" ]; then
        echo "  OK      $(basename "$target") (copied)"
        found="yes"
      elif [ -d "$target" ]; then
        echo "  OK      $(basename "$target") (project copy)"
        found="yes"
      fi
    done
    [ -z "$found" ] && echo "  MISSING $skill"
  done
  qabuddy_prune_orphans report
  echo ""
  # Check Playwright MCP
  if [ -f ".cursor/mcp.json" ] && grep -q "playwright" ".cursor/mcp.json" 2>/dev/null; then
    echo "  OK      Playwright MCP configured (project)"
  elif [ -f "$HOME/.cursor/mcp.json" ] && grep -q "playwright" "$HOME/.cursor/mcp.json" 2>/dev/null; then
    echo "  OK      Playwright MCP configured (global)"
  else
    echo "  WARN    Playwright MCP not detected"
  fi
  # Check Atlassian MCP
  if [ -f ".cursor/mcp.json" ] && grep -q "atlassian" ".cursor/mcp.json" 2>/dev/null; then
    echo "  OK      Atlassian MCP configured (project)"
  elif [ -f "$HOME/.cursor/mcp.json" ] && grep -q "atlassian" "$HOME/.cursor/mcp.json" 2>/dev/null; then
    echo "  OK      Atlassian MCP configured (global)"
  else
    echo "  WARN    Atlassian MCP not detected"
  fi
  exit 0
fi

# ─── Install ─────────────────────────────────────────────────────────────────

echo "QABuddy — Setup (Cursor)"
echo "NOTE: Cursor is an UNVERIFIED platform — CI does not execute this installer."
echo "      Officially supported: Claude Code. Issue reports welcome."
echo "==========================="
echo "Mode: $MODE"
echo ""
if [ "$ADOPT" = "1" ]; then
  echo "Adopting pre-v0.2.3 legacy copies:"
  adopt_legacy "$SKILLS_DIR"
  [ -d ".cursor/skills" ] && [ "$SKILLS_DIR" != ".cursor/skills" ] && adopt_legacy ".cursor/skills"
  echo ""
fi

mkdir -p "$SKILLS_DIR"

qabuddy_prune_orphans remove

installed=0
skipped=0

for skill in "${SKILLS[@]}"; do
  target="$SKILLS_DIR/${PREFIX}$skill"
  source="$SDT_SKILLS/$skill"

  if [ ! -d "$source" ]; then
    echo "  SKIP    $skill (source not found)"
    skipped=$((skipped + 1))
    continue
  fi

  if [ "$MODE" = "project" ]; then
    # Copy to project directory
    if [ -d "$target" ] && [ ! -f "$target/.qabuddy-owned" ]; then
      echo "  FAIL    ${PREFIX}$skill — unowned directory occupies $target. Pre-v0.2.3 QABuddy copy? Re-run with --adopt. Otherwise remove it manually."
      skipped=$((skipped + 1))
      continue
    fi
    rm -rf "$target"
    cp -r "$source" "$target"
    echo "$source" > "$target/.qabuddy-owned"
    echo "  OK      ${PREFIX}$skill (copied)"
  else
    # Symlink to global directory
    if [ -L "$target" ]; then
      link_target=$(readlink "$target" 2>/dev/null || true)
      if [[ "$link_target" == *"$SDT_SKILLS"* ]] || [[ "$link_target" == *"qa-skills"* ]]; then
        rm "$target"
      else
        echo "  FAIL    ${PREFIX}$skill — another tool's link occupies $target. Remove it manually or use prefix mode."
        skipped=$((skipped + 1))
        continue
      fi
    elif [ -d "$target" ]; then
      echo "  WARN    $target exists and is not a symlink. Skipping."
      skipped=$((skipped + 1))
      continue
    fi
    ln -s "$source" "$target"
    echo "  OK      ${PREFIX}$skill -> $source"
  fi
  installed=$((installed + 1))
done

# Install references
ref_target="$SKILLS_DIR/qa-references"
if [ -d "$SDT_REFS" ]; then
  if [ "$MODE" = "project" ]; then
    rm -rf "$ref_target"
    cp -r "$SDT_REFS" "$ref_target"
    echo "$SDT_REFS" > "$ref_target/.qabuddy-owned"
    echo "  OK      qa-references (copied)"
  else
    [ -L "$ref_target" ] && rm "$ref_target"
    ln -s "$SDT_REFS" "$ref_target"
    echo "  OK      qa-references -> $SDT_REFS"
  fi
  installed=$((installed + 1))
fi

echo ""
echo "Installed: $installed items ($((installed - 1)) skills + references)"
[ $skipped -gt 0 ] && echo "Skipped: $skipped skills"

# ─── MCP Checks ─────────────────────────────────────────────────────────────

echo ""
echo "Checking MCP servers..."

# Playwright MCP
playwright_found=false
for config in ".cursor/mcp.json" "$HOME/.cursor/mcp.json"; do
  if [ -f "$config" ] && grep -q "playwright" "$config" 2>/dev/null; then
    playwright_found=true
    break
  fi
done

if $playwright_found; then
  echo "  OK      Playwright MCP configured"
else
  echo "  WARN    Playwright MCP not detected"
  echo ""
  echo "  Browser-testing skills (qa, qa-report, exploratory) need Playwright MCP."
  echo "  Add to .cursor/mcp.json or ~/.cursor/mcp.json:"
  echo ""
  echo '  {
    "mcpServers": {
      "playwright": {
        "command": "npx",
        "args": ["@playwright/mcp@latest"]
      }
    }
  }'
fi

# Atlassian MCP
atlassian_found=false
for config in ".cursor/mcp.json" "$HOME/.cursor/mcp.json"; do
  if [ -f "$config" ] && grep -q "atlassian" "$config" 2>/dev/null; then
    atlassian_found=true
    break
  fi
done

echo ""
if $atlassian_found; then
  echo "  OK      Atlassian MCP configured"
else
  echo "  WARN    Atlassian MCP not detected"
  echo ""
  echo "  Most QABuddy skills need Jira/Confluence access via Atlassian MCP."
  echo "  Add to .cursor/mcp.json or ~/.cursor/mcp.json:"
  echo ""
  echo '  {
    "mcpServers": {
      "atlassian": {
        "command": "npx",
        "args": ["-y", "@anthropic/mcp-atlassian"],
        "env": {
          "JIRA_URL": "https://your-domain.atlassian.net",
          "JIRA_EMAIL": "your-email@company.com",
          "JIRA_API_TOKEN": "your-api-token"
        }
      }
    }
  }'
fi

# ─── SessionStart Hook ──────────────────────────────────────────────────────

echo ""
echo "Checking SessionStart hook..."

hook_configured=false
if [ -f ".cursor/settings.json" ] && grep -q "SessionStart" ".cursor/settings.json" 2>/dev/null; then
  hook_configured=true
fi

if $hook_configured; then
  echo "  OK      SessionStart hook configured"
else
  echo "  INFO    SessionStart hook not configured"
  echo ""
  echo "  The hook auto-injects .qabuddy.json config into every session."
  echo "  Add this to .cursor/settings.json:"
  echo ""
  echo '  {
    "hooks": {
      "SessionStart": [{
        "hooks": [{
          "type": "command",
          "command": "cat .qabuddy.json 2>/dev/null || echo '"'"'{}'"'"'"
        }]
      }]
    }
  }'
  echo ""
  echo "  Or run /qa-setup to configure QABuddy interactively."
fi

# ─── Summary ─────────────────────────────────────────────────────────────────

echo ""
echo "─────────────────────────────────────"
if [ -n "$PREFIX" ]; then
  echo "Skills installed with prefix. Use as:"
  echo "  /qa-qa, /qa-test-plan, /qa-test-cases, etc."
  echo ""
  echo "For short names: $0 --no-prefix"
else
  echo "Skills installed without prefix. Use as:"
  echo "  /qa, /test-plan, /test-cases, /review-ticket, etc."
fi
echo ""
echo "Check status:  $0 --status"
echo "Uninstall:     $0 --uninstall"
