{
  "skill": "start",
  "version": "0.3.2",
  "fixtures": [
    {
      "id": "fx-001",
      "description": "Full guided workflow completes all phases",
      "input": {
        "epic": "epic with 3 stories and clear ACs"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "Test Plan"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Test Cases"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Planning Complete"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "DONE"
        }
      ],
      "tags": [
        "happy-path",
        "full-workflow"
      ]
    },
    {
      "id": "fx-002",
      "description": "Pauses after every phase for review",
      "input": {
        "epic": "any epic"
      },
      "assertions": [
        {
          "field": "output",
          "op": "matches",
          "value": "Approve|approve|Continue|continue"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "Review|review"
        }
      ],
      "tags": [
        "pause-points"
      ]
    },
    {
      "id": "fx-003",
      "description": "Resumes from interrupted workflow",
      "input": {
        "precondition": "features-kb/index.json has workflow.phase for this epic",
        "epic": "previously started epic"
      },
      "assertions": [
        {
          "field": "output",
          "op": "matches",
          "value": "Resume|resume|left off"
        }
      ],
      "tags": [
        "resume"
      ]
    },
    {
      "id": "fx-004",
      "description": "Runs setup wizard inline if no config",
      "input": {
        "precondition": "no .qabuddy.json",
        "epic": "any epic"
      },
      "assertions": [
        {
          "field": "output",
          "op": "matches",
          "value": "context source|Context source|Jira|spec|chat"
        }
      ],
      "tags": [
        "inline-setup"
      ]
    },
    {
      "id": "fx-005",
      "description": "Headless: completes every phase without asking, records auto-decisions",
      "input": {
        "env": "QABUDDY_HEADLESS=1",
        "epic": "epic with 3 stories and clear ACs, .qabuddy.json present"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "Auto-decisions"
        },
        {
          "field": "output",
          "op": "not_contains",
          "value": "Proceed with test planning"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Planning Complete"
        }
      ],
      "tags": [
        "headless",
        "rfc-0004"
      ]
    }
  ]
}
