{
  "skill": "sprint-status",
  "version": "0.4.1",
  "fixtures": [
    {
      "id": "fx-001",
      "description": "Dashboard with mixed ticket statuses",
      "input": {
        "sprint": "sprint with 5 tickets: 2 QA passed, 1 bugs open, 1 not started, 1 blocked"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "Per-Ticket Status"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Sprint Quality Metrics"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Defect escape rate"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Test pass rate"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Recommendations"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "DONE"
        }
      ],
      "tags": [
        "happy-path",
        "mixed-status"
      ]
    },
    {
      "id": "fx-002",
      "description": "Confidence score LOW when critical bugs open",
      "input": {
        "sprint": "sprint with 2 Critical bugs open, 3 tickets untested"
      },
      "assertions": [
        {
          "field": "output",
          "op": "matches",
          "value": "[Ll]ow"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Risk Items"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Critical"
        }
      ],
      "tags": [
        "low-confidence",
        "critical-bugs"
      ]
    },
    {
      "id": "fx-003",
      "description": "Recommendations include specific skill commands",
      "input": {
        "sprint": "sprint with tickets at various stages"
      },
      "assertions": [
        {
          "field": "output",
          "op": "matches",
          "value": "/qa-|/verify-fix|/test-cases|/review-ticket"
        }
      ],
      "tags": [
        "recommendations",
        "skill-commands"
      ]
    },
    {
      "id": "fx-004",
      "description": "Metrics show N/A when data is unavailable",
      "input": {
        "sprint": "sprint with no QA reports, no bugs filed"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "N/A"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Sprint Quality Metrics"
        }
      ],
      "tags": [
        "missing-data",
        "graceful"
      ]
    }
  ]
}
