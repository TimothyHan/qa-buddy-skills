{
  "skill": "test-plan",
  "version": "0.5.3",
  "fixtures": [
    {
      "id": "fx-001",
      "description": "Test plan for epic with linked stories",
      "input": {
        "epic": "epic with 5 linked stories, clear ACs"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "Test Plan"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Test Strategy"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Gap Analysis"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Entry"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Risks"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "DONE"
        }
      ],
      "tags": [
        "happy-path"
      ]
    },
    {
      "id": "fx-002",
      "description": "feature.md created before test plan is drafted",
      "input": {
        "epic": "new epic with no existing KB"
      },
      "assertions": [
        {
          "field": "file:features-kb/features/*/feature.md",
          "op": "exists"
        },
        {
          "field": "file:features-kb/index.json",
          "op": "exists"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "feature.md"
        }
      ],
      "tags": [
        "kb-init",
        "feature-md-first"
      ]
    },
    {
      "id": "fx-003",
      "description": "Resolved stories use Confirmed/Unverified, never Done (in PR)",
      "input": {
        "epic": "epic with 3 resolved stories, 2 open stories"
      },
      "assertions": [
        {
          "field": "output",
          "op": "matches",
          "value": "Confirmed|Unverified|Pending"
        },
        {
          "field": "output",
          "op": "not_contains",
          "value": "Done (in PR)"
        }
      ],
      "tags": [
        "no-inferred-status"
      ]
    },
    {
      "id": "fx-004",
      "description": "Gap analysis only claims verified coverage",
      "input": {
        "epic": "epic with mix of tested and untested stories"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "Gap Analysis"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "Confirmed|Unverified|No coverage|N/A"
        }
      ],
      "tags": [
        "gap-analysis",
        "verified-only"
      ]
    },
    {
      "id": "fx-005",
      "description": "Automation strategy states how the suite's detection power gets proven (test-suite-verification.md)",
      "input": {
        "epic": "epic whose scope includes building a new automated regression suite from scratch"
      },
      "assertions": [
        {
          "field": "output",
          "op": "matches",
          "value": "mutation smoke|detection power|뮤테이션 스모크|검출력"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "vacuous|red|공허|빨간"
        }
      ],
      "tags": [
        "suite-verification",
        "detection-power"
      ]
    },
    {
      "id": "fx-006",
      "description": "No features-kb/ directory — creates the KB structure instead of failing (was BT-041)",
      "input": {
        "epic": "EPIC-100 with 3 linked stories, each with ACs",
        "preconditions": "no features-kb/ directory exists in the project"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "features-kb/features/EPIC-100"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "feature.md"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "test-plan.md"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "index.json"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "Status:\\**\\s*(DONE|DONE_WITH_CONCERNS)\\b(?!\\s*\\|)"
        }
      ],
      "tags": [
        "degradation",
        "no-kb"
      ]
    },
    {
      "id": "fx-007",
      "description": "Headless: drafts without the confirm-context question and writes sources.json",
      "input": {
        "env": "QABUDDY_HEADLESS=1",
        "epic": "EPIC-100 with 2 resolved stories, spec context source"
      },
      "assertions": [
        {
          "field": "file:features-kb/features/*/sources.json",
          "op": "exists",
          "value": true
        },
        {
          "field": "output",
          "op": "not_contains",
          "value": "Anything missing or incorrect"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Auto-decisions"
        }
      ],
      "tags": [
        "headless",
        "rfc-0004"
      ]
    }
  ]
}
