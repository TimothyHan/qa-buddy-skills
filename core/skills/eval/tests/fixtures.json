{
  "skill": "eval",
  "version": "0.5.0",
  "fixtures": [
    {
      "id": "fx-001",
      "description": "Runs all fixtures for a skill and reports results",
      "input": {
        "skill": "review-ticket"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "Eval Results"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Pass rate"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "PASS|FAIL"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "DONE"
        }
      ],
      "tags": [
        "happy-path"
      ]
    },
    {
      "id": "fx-002",
      "description": "Reports missing fixtures gracefully",
      "input": {
        "skill": "skill-with-no-fixtures"
      },
      "assertions": [
        {
          "field": "output",
          "op": "matches",
          "value": "No fixtures|not found"
        }
      ],
      "tags": [
        "no-fixtures"
      ]
    },
    {
      "id": "fx-003",
      "description": "Failed assertions include evidence",
      "input": {
        "skill": "any skill with a failing fixture"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "Failed Assertions"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Evidence"
        }
      ],
      "tags": [
        "failure-evidence"
      ]
    },
    {
      "id": "fx-004",
      "description": "--rubric delegates to eval.js run and reports its report.md verbatim",
      "input": {
        "context": "/qa-eval test-cases --rubric; tests/rubric.json exists"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "eval.js run"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "report.md"
        },
        {
          "field": "output",
          "op": "not_contains",
          "value": "simulate the scenario"
        }
      ],
      "tags": [
        "rfc-0005",
        "rubric"
      ]
    }
  ]
}
