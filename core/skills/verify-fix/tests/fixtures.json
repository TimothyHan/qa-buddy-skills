{
  "skill": "verify-fix",
  "version": "0.4.0",
  "fixtures": [
    {
      "id": "fx-001",
      "description": "Fix works, no regression — VERIFIED",
      "input": {
        "bug": "bug with clear repro steps, fix deployed and working"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "VERIFIED"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Regression Check"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "DONE"
        }
      ],
      "tags": [
        "happy-path",
        "verified"
      ]
    },
    {
      "id": "fx-002",
      "description": "Fix doesn't work — FAILED",
      "input": {
        "bug": "bug still reproduces after supposed fix"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "FAILED"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "evidence"
        }
      ],
      "tags": [
        "failed"
      ]
    },
    {
      "id": "fx-003",
      "description": "Fix works but broke something else — REGRESSION",
      "input": {
        "bug": "bug fixed but adjacent feature broke"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "REGRESSION"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "new bug|BUG-"
        }
      ],
      "tags": [
        "regression"
      ]
    },
    {
      "id": "fx-004",
      "description": "Flags missing regression test",
      "input": {
        "bug": "bug verified, no regression test added by dev"
      },
      "assertions": [
        {
          "field": "output",
          "op": "matches",
          "value": "regression test|no.*test"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "recommend|suggest|flag"
        }
      ],
      "tags": [
        "missing-regression-test"
      ]
    },
    {
      "id": "fx-005",
      "description": "NOT REPRODUCED path: the original bug no longer shows but nothing explains it, and the first report was taken under different run conditions. The skill must reconstruct those conditions (time/timezone first), report NOT REPRODUCED with the conditions named, and leave the bug open — never VERIFIED. Wrong output this catches: verifying a fix that was never made because the retry ran under different conditions.",
      "input": {
        "request": "verify the fix for BUG-77",
        "precondition": "BUG-77's repro steps pass cleanly today. No fix commit, PR or deploy is linked to the bug. The original report was recorded at 23:07 local time on a machine whose timezone is behind UTC (so the local date differed from the UTC date); the retry is running at 00:02 local."
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "NOT REPRODUCED"
        },
        {
          "field": "output",
          "op": "not_contains",
          "value": "## Verdict: VERIFIED",
          "note": "no fix exists — verifying would be false"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "(timezone|타임존|UTC|time of day|시각)"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "(not reproduced under|conditions tried|시도한 조건|재구성한 조건)"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "(stays open|remains open|열린 채)"
        }
      ],
      "tags": [
        "verify-fix",
        "not-reproducible",
        "conditions"
      ]
    }
  ]
}
