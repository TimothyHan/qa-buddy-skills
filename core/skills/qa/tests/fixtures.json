{
  "skill": "qa",
  "version": "0.3.2",
  "fixtures": [
    {
      "id": "fx-001",
      "description": "All test cases pass, all ACs verified",
      "input": {
        "ticket": "ticket with test cases in KB, all features working"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "AC Verification"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "PASS"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Test Execution Summary"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "DONE"
        }
      ],
      "tags": [
        "happy-path",
        "all-pass"
      ]
    },
    {
      "id": "fx-002",
      "description": "Failed test case triggers bug filing",
      "input": {
        "ticket": "ticket with a broken feature"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "FAIL"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Bugs Filed"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Severity"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "approval"
        }
      ],
      "tags": [
        "bug-filing",
        "fail"
      ]
    },
    {
      "id": "fx-003",
      "description": "No test cases in KB triggers prompt to generate them",
      "input": {
        "ticket": "ticket with no test cases in features-kb/"
      },
      "assertions": [
        {
          "field": "output",
          "op": "matches",
          "value": "/qa-test-cases|test cases"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "generate|first|No test cases"
        }
      ],
      "tags": [
        "no-test-cases",
        "prompt"
      ]
    },
    {
      "id": "fx-004",
      "description": "Bug filed to KB when no Jira",
      "input": {
        "config": {
          "contextSource": "spec"
        },
        "ticket": "ticket with a broken feature, no Jira MCP"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "features-kb"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "bugs/"
        }
      ],
      "tags": [
        "no-jira",
        "kb-bug"
      ]
    },
    {
      "id": "fx-005",
      "mode": "simulate",
      "description": "Data-exposure defect is rated on what it exposes, not on what it blocks",
      "input": {
        "ticket": "ticket whose API returns customer enquiries",
        "scenario": "Exploratory check during the run: GET /api/message and GET /api/message/{id} answer 200 to a caller with NO credentials, returning every enquiry's name, email, phone and message body. Writes (PUT/DELETE) are correctly rejected with 403. Every documented user workflow completes normally — nothing is blocked, there is no error, and no test case fails on its own steps."
      },
      "assertions": [
        {
          "field": "output",
          "op": "matches",
          "value": "Blocker|Critical",
          "note": "the scale is written around blocked workflows; a confidentiality failure blocks nothing, so a literal reading lands on Normal/Minor. Added 2026-08-19 after BUG-013 was rated by improvising outside the scale."
        },
        {
          "field": "output",
          "op": "not_contains",
          "value": "Severity:** Minor"
        },
        {
          "field": "output",
          "op": "not_contains",
          "value": "Severity:** Normal"
        },
        {
          "field": "output",
          "op": "not_contains",
          "value": "Severity:** Trivial"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "expos|unauthenticated|authorization"
        }
      ]
    }
  ]
}
