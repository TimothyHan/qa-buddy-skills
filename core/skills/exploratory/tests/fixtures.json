{
  "skill": "exploratory",
  "version": "0.4.3",
  "fixtures": [
    {
      "id": "fx-001",
      "description": "Generates charter with heuristic focus areas",
      "input": {
        "feature": "feature with existing test cases in KB"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "Charter"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Focus Area"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Mission"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Already Tested"
        }
      ],
      "tags": [
        "charter",
        "happy-path"
      ]
    },
    {
      "id": "fx-002",
      "description": "Findings categorized with severity and evidence",
      "input": {
        "feature": "feature with discoverable bugs"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "Finding"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "new-scenario|bug|ux-concern|missing-requirement|question"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Severity"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Evidence"
        }
      ],
      "tags": [
        "findings",
        "evidence"
      ]
    },
    {
      "id": "fx-003",
      "description": "Session report with recommendation",
      "input": {
        "feature": "any feature after exploratory session"
      },
      "assertions": [
        {
          "field": "output",
          "op": "contains",
          "value": "Session Outcome"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "Recommendation"
        },
        {
          "field": "output",
          "op": "matches",
          "value": "Proceed|another session|Blocked"
        },
        {
          "field": "output",
          "op": "contains",
          "value": "DONE"
        }
      ],
      "tags": [
        "report",
        "recommendation"
      ]
    },
    {
      "id": "fx-004",
      "description": "Headless: charter approved as written, session persisted into the KB with an AC-keyed results table",
      "input": {
        "env": "QABUDDY_HEADLESS=1",
        "feature": "projects",
        "url": "http://localhost:4173",
        "flags": "--quick"
      },
      "assertions": [
        {
          "field": "file:features-kb/features/*/exploratory/*.md",
          "op": "exists",
          "value": true
        },
        {
          "field": "file:features-kb/features/*/exploratory/*.md",
          "op": "contains",
          "value": "| Result |"
        },
        {
          "field": "output",
          "op": "not_contains",
          "value": "Adjust focus areas"
        }
      ],
      "tags": [
        "headless",
        "rfc-0004"
      ]
    }
  ]
}
